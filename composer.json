{
  "name": "jijila/syde-users-table",
  "description": "A WordPress plugin that displays JSONPlaceholder users at a custom endpoint.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "phpunit/phpunit": "^10.5",
    "syde/phpcs": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Syde\\UsersTable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Syde\\UsersTable\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs": "phpcs",
    "check": [
      "@cs",
      "@test"
    ]
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}